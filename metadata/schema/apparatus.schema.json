{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/principia/apparatus.schema.json",
  "title": "Principia Mathematica critical-apparatus entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "item", "locus", "classification", "diplomatic_reading",
    "witnesses", "evidence", "status", "review"
  ],
  "properties": {
    "id": { "type": "string" },
    "item": { "type": "string" },
    "locus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume", "printed_page", "scan_leaf"],
      "properties": {
        "volume": { "enum": [1, 2, 3] },
        "printed_page": { "type": ["integer", "string"] },
        "scan_leaf": { "type": ["integer", "string"] },
        "line_or_formula": { "type": "string" }
      }
    },
    "classification": {
      "enum": [
        "authorial-print-sic", "digital-witness-error",
        "editorial-correction", "variant", "uncertain"
      ]
    },
    "marker": { "enum": ["sic", "corr.", "conj.", "lege", "om.", "add."] },
    "diplomatic_reading": { "type": "string" },
    "other_reading": { "type": "string" },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["siglum", "reading", "uri"],
        "properties": {
          "siglum": { "type": "string" },
          "reading": { "type": "string" },
          "uri": { "type": "string", "format": "uri" }
        }
      }
    },
    "evidence": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "single-checked", "double-checked", "adopted"] },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editor", "date"],
      "properties": {
        "editor": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "second_reviewer": { "type": "string" }
      }
    }
  }
}
