{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/principia/assumptions.schema.json",
  "title": "Principia Mathematica non-logical assumption registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assumptions"],
  "properties": {
    "schema_version": { "const": 1 },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "volume", "loci", "status", "lean_parameter_types", "editorial_note"],
        "properties": {
          "id": { "type": "string", "pattern": "^PM[123]:[A-Z][A-Z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "volume": { "enum": [1, 2, 3] },
          "loci": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": {
            "enum": [
              "catalogued-not-yet-formalized",
              "catalogued-locus-pending-source-audit",
              "formalized-explicit-hypothesis"
            ]
          },
          "lean_parameter_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)+$"
            }
          },
          "editorial_note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
